/* Reset styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Arial", sans-serif;
}

/* Main App */
.app {
  text-align: center;
  background: linear-gradient(to bottom, #5435ed2c, rgba(255, 255, 255, 1), rgba(255, 255, 255, 1), #5435ed1f);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
}

/* Navbar Styles */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  padding: 15px 20px;
  background: transparent;
  transition: background 0.3s ease, backdrop-filter 0.3s ease;
  z-index: 1000;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Change navbar background when scrolling */
.navbar.scrolled {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Navbar Logo */
.navbar .logo {
  font-size: 2rem;
  font-weight: bold;
  color: #5435ED;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-family: "Arial", sans-serif;
  margin-left: 20px;
}

/* Hero Section */
.hero {
  text-align: center;
  padding: 50px;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 20px;
}

.hero h1 {
  font-size: 3.75rem;
  font-weight: bold;
  color: #5435ED;
  font-family: "Playfair Display", serif;
}
.hero h1 {
  font-size: 3rem;
  font-weight: bold;
  background: linear-gradient(90deg, #007bff, #5435ED, #007bff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  }

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.hero p {
  font-size: 1.5rem;
  color: #373d48;
  margin-top: 10px;
}

/* Try Button */
.try-button {
  margin-top: 40px;
  padding: 12px 24px;
  font-size: 1.2rem;
  color: white;
  background: #5435ED;
  border: none;
  border-radius: 20px;
  cursor: pointer;
  transition: background 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  animation: bounce 1.5s infinite;
  
}

.try-button:hover {
  background: #f3f3f3;
  color: #5435ED;
  border: 1px solid #5435ED;
  
}

/* Arrow */

/* Bounce Animation */
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

/* Offers Section */
.offers {
  text-align: center;
  padding: 50px 20px;

}

.offers h1 {
  font-size: 2.5rem;
  font-family: "Playfair Display", serif;
  color: black;
  margin-bottom: 20px;
}
.offers h1 o{
  font-size: 2.5rem;
  font-family: "Playfair Display", serif;
  color: #5435ED;
  font-weight: 100;
  margin-bottom: 20px;
}

.offer-cards {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.offer-card {
  background: white;
  padding: 20px;
  width: 340px;
  height: 190px;
  border-radius: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
}

.offer-card:hover {
  transform: translateY(-5px);
}

.offer-card h2 {
  font-size: 1.25rem;
  color: #000000;
  margin-bottom: 10px;
  font-family: Playfair Display, serif;
}

.offer-card p {
  font-size: 1rem;
  color: #333;
}
.icon {
  font-size: 50px;
  color: #5435ED;
  margin-bottom: 15px;
}

/* Upload Section */
.upload-container {
  text-align: center;
  width: 100%;
  max-width: 800px;
  margin-top: 50px;
}

.upload-container h2 {
  font-size: 24px;
  color: #333;
  margin-bottom: 20px;
}

.upload-box {
  border: 2px dashed #5435ED;
  border-radius: 10px;
  padding: 40px;
  background: #f9f9f9;
  cursor: pointer;
  text-align: center;
  transition: all 0.3s ease;
}

.upload-box:hover {
  background: #e6f2ff;
}

.upload-icon {
  font-size: 50px;
  color: #5435ED;
  margin-bottom: 10px;
}

.upload-box p {
  font-size: 16px;
  color: #555;
}

.upload-button {
  display: inline-block;
  background: #5435ED;
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 16px;
  margin-top: 10px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.upload-button:hover {
  background: #5435ED;
}

.file-name {
  margin-top: 10px;
  font-size: 14px;
  color: #28a745;
}

.upload-submit {
  margin-top: 20px;
  padding: 10px 20px;
  font-size: 16px;
  background: #28a745;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.upload-submit:disabled {
  background: #ccc;
  cursor: not-allowed;
}

.upload-submit:hover {
  background: #218838;
}

.uploaded-preview img{
  height: 350px;
  width: 800px;
  align-content: center;
  opacity: calc(50%);
}

.progress-bar {
  height: 5px;
  background: #5435ED;
  width: 0%;
  margin-top: 10px;
  transition: width 0.3s ease;
}

/* Result Section */
.result-container {
  margin-top: 30px;
}

.result-card{
  height: fit-content;
  width:800px;
  text-align: justify;
  background: white;
  padding: 20px;
  border-radius: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s;
}
.result-card h3{
  font-size: 1.25rem;
  color: #5435ED;
  margin-bottom: 10px;
  font-family: Playfair Display, serif;
}

.audio-container audio {
  width: 100%;
  border-radius: 6px;
  margin-top: 10px;
}

