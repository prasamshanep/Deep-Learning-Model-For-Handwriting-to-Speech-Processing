from flask import Flask, request, jsonify
from gtts import gTTS
import numpy as np
import tensorflow as tf
from tensorflow.keras.models import load_model
import cv2
import os
from pyngrok import ngrok

# Setup
app = Flask(__name__)
UPLOAD_FOLDER = '/content/uploads'
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

# Load model
model = load_model(f'/content/{model_filename}', compile=False)

# Character dictionary (same as training)
CHARACTERS = 'abcdefghijklmnopqrstuvwxyz0123456789 '
char_to_int = {ch: i for i, ch in enumerate(CHARACTERS)}
int_to_char = {i: ch for i, ch in enumerate(CHARACTERS)}

# Preprocess uploaded image
def preprocess_image(image_path, img_size=(128, 32)):
    img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    img = cv2.resize(img, img_size)
    img = img / 255.0
    img = np.expand_dims(img, axis=(0, -1))  # shape: (1, H, W, 1)
    return img

# Decode model prediction
def decode_prediction(pred):
    input_len = np.ones(pred.shape[0]) * pred.shape[1]
    decoded = tf.keras.backend.ctc_decode(pred, input_length=input_len, greedy=True)[0][0]
    decoded = tf.keras.backend.get_value(decoded)
    return ''.join([int_to_char.get(i, '') for i in decoded[0]])

# Flask route to handle image uploads
@app.route('/predict', methods=['POST'])
def predict():
    if 'image' not in request.files:
        return jsonify({'error': 'No image uploaded'}), 400

    # Save uploaded image
    file = request.files['image']
    image_path = os.path.join(UPLOAD_FOLDER, file.filename)
    file.save(image_path)

    # Preprocess and predict
    img = preprocess_image(image_path)
    prediction = model.predict(img)
    decoded_text = decode_prediction(prediction)

    # Convert to speech
    audio_path = os.path.join(UPLOAD_FOLDER, 'output.mp3')
    gTTS(decoded_text).save(audio_path)

    return jsonify({
        'text': decoded_text,
        'audio_url': f"{public_url}/audio"
    })

# Endpoint to serve audio file
@app.route('/audio')
def audio():
    return app.send_static_file('uploads/output.mp3')
